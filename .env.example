# Copy this file to .env (docker compose reads .env from the project root automatically) and
# fill in real values. .env is gitignored — never commit it. See
# docs/rules/security-and-permissions.md: the OpenRouter key must never reach the browser or be
# baked into the image; it's injected into the running container as an env var only.
#
# Variable names below are confirmed against the actual backend code (lib/openrouter/client.ts,
# lib/db/client.ts) as of 2026-08-17 — no longer a guess.

# ---- OpenRouter (backend-only; never sent to the browser) ----
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Database (MongoDB Atlas — ADR-0017, docs/decisions/0017-mongodb-atlas-database.md) ----
# Atlas is a hosted, always-remote cluster: there's no local container to stand in for it, unlike
# the earlier Postgres setup. Local dev and production both point at a real Atlas connection
# string via this same variable — only which cluster/database differs, not the mechanism.
# Format: mongodb+srv://<db_username>:<db_password>@cluster0.ak3ciam.mongodb.net/?appName=Cluster0
MONGODB_URI=

# Optional: database name within the Atlas cluster (defaults to "agnet" in code if unset). Set
# this if local dev and production should use separate databases in the same cluster — still an
# open/undecided item as of ADR-0017, not assumed either way here.
# MONGODB_DB_NAME=

# ---- Next.js runtime ----
NODE_ENV=production
PORT=3000
